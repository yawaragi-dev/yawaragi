# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# next-agents-md
.next-docs/

# Claude Code agent worktrees — temporary git checkouts the harness creates
# under `.claude/worktrees/agent-<id>/` for parallel / isolated agent runs.
# Each is its own checkout; nothing inside should ever be committed from
# the main worktree.
.claude/worktrees/
