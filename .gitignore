# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# next-agents-md
.next-docs/

# Claude Code agent worktrees — temporary git checkouts the harness creates
# under `.claude/worktrees/agent-<id>/` for parallel / isolated agent runs.
# Each is its own checkout; nothing inside should ever be committed from
# the main worktree.
.claude/worktrees/

# Claude Code local-only state — scheduled-task lock file is per-machine
# scratch used by ScheduleWakeup, not project content.
.claude/scheduled_tasks.lock

# clerk configuration (can include secrets)
/.clerk/

# `pnpm journal:export` output — account-linked personal data (ADR-0009 RoPA:
# the tasting journal). Written to the working directory by default; must never
# be committed. Delete the file once the request that prompted it is satisfied.
journal-export-*.json
# `pnpm romaji:regenerate` report — catalogue names, regenerable
romaji-regeneration*.json

# label-scan eval — optional local provider list (env var is the committed
# path; this file is a local convenience, see evals/label-scan-jp/README.md).
/evals/label-scan-jp/providers.json

# Design snapshot: the self-contained phone build is a 4.8MB duplicate of
# "Yawaragi Mobile.dc.html" (open-on-your-phone convenience). Committing it per
# design release compounds and it does not delta-compress.
design/**/*(phone).html

# Photos of real menus stay on the maintainer's machine. A designed menu
# carries other people's text, artwork and product photographs, and nothing
# in German copyright law allows publishing a photo of one (research of
# 2026-10-13, see evals/label-scan-jp/README.md "Compliance"). The file name
# says what a photo is, so the name is what is ignored. The ground-truth
# entry (names, sizes, prices: facts) and the saved reads are committed; the
# eval runs a photo only where its file exists.
/evals/label-scan-jp/photos/*menu*
