{
  "name": "yawaragi",
  "version": "1.10.0",
  "private": true,
  "description": "Yawaragi — a sake companion. Label scan, chat recommender, taste profile.",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yawaragi-dev/yawaragi.git"
  },
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:mcp-integration": "vitest run --config vitest.mcp.config.mts",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test --config playwright.smoke.config.ts",
    "i18n:audit": "tsx scripts/audit-i18n-promotional.ts",
    "anthropic-files:audit": "tsx scripts/audit-anthropic-files-api.ts",
    "migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "db:reset": "tsx --env-file=.env.local scripts/reset-db.ts",
    "ingest": "tsx --env-file=.env.local scripts/ingest-sakenowa.ts",
    "romaji:regenerate": "tsx --env-file=.env.local scripts/romaji-regenerate.ts",
    "add-manual-brand": "tsx --env-file=.env.local scripts/add-manual-brand.ts",
    "sakenowa:freshness": "tsx --env-file=.env.local scripts/sakenowa-freshness-check.ts",
    "rate-limit:reset": "tsx --env-file=.env.local scripts/clear-rate-limit.ts",
    "stats": "tsx --env-file=.env.local scripts/usage-stats.ts",
    "journal:export": "tsx --conditions react-server --env-file=.env.local scripts/export-journal.ts",
    "journal:restore": "tsx --conditions react-server --env-file=.env.local scripts/restore-journal.ts",
    "journal:erase": "tsx --conditions react-server --env-file=.env.local scripts/erase-collection.ts",
    "accounts:inactive": "tsx --conditions react-server --env-file=.env.local scripts/inactive-accounts.ts",
    "eval": "tsx --conditions=react-server --env-file=.env.local scripts/eval.ts",
    "db:resync": "pnpm db:reset --yes && pnpm migrate && pnpm ingest",
    "docs:check": "node scripts/docs-check.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:integration && pnpm test:e2e && pnpm i18n:audit && pnpm anthropic-files:audit && pnpm docs:check"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.76",
    "@ai-sdk/mcp": "^2.0.71",
    "@ai-sdk/react": "^4.0.136",
    "@base-ui/react": "^1.8.0",
    "@clerk/nextjs": "^7.9.12",
    "@langfuse/otel": "5.11.1",
    "@langfuse/tracing": "5.11.1",
    "@langfuse/vercel-ai-sdk": "5.11.1",
    "@opentelemetry/api": "1.9.1",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.116.0",
    "@vercel/otel": "2.1.3",
    "@yawaragi/sakenowa-mcp": "0.1.0",
    "ai": "^7.0.133",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "next": "16.4.1",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4",
    "@testcontainers/postgresql": "~12.1.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26",
    "@types/pg": "~8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "happy-dom": "^20.14.5",
    "pg": "~8.23.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^6",
    "vitest": "^5.0.3"
  }
}
