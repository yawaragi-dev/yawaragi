{
  "name": "yawaragi",
  "version": "0.1.0",
  "private": true,
  "description": "Yawaragi — a sake companion. Label scan, chat recommender, taste profile.",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yawaragi-dev/yawaragi.git"
  },
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:mcp-integration": "vitest run --config vitest.mcp.config.mts",
    "test:e2e": "playwright test",
    "i18n:audit": "tsx scripts/audit-i18n-promotional.ts",
    "progress": "tsx scripts/progress-dashboard.ts",
    "anthropic-files:audit": "tsx scripts/audit-anthropic-files-api.ts",
    "migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "db:reset": "tsx --env-file=.env.local scripts/reset-db.ts",
    "ingest": "tsx --env-file=.env.local scripts/ingest-sakenowa.ts",
    "add-manual-brand": "tsx --env-file=.env.local scripts/add-manual-brand.ts",
    "sakenowa:freshness": "tsx --env-file=.env.local scripts/sakenowa-freshness-check.ts",
    "rate-limit:reset": "tsx --env-file=.env.local scripts/clear-rate-limit.ts",
    "journal:export": "tsx --conditions react-server --env-file=.env.local scripts/export-journal.ts",
    "eval": "tsx --env-file=.env.local scripts/eval.ts",
    "db:resync": "npm run db:reset -- --yes && npm run migrate && npm run ingest",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run test:integration && npm run test:e2e && npm run i18n:audit && npm run anthropic-files:audit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.86",
    "@ai-sdk/mcp": "^1.0.52",
    "@ai-sdk/react": "^3.0.211",
    "@base-ui/react": "^1.6.0",
    "@clerk/nextjs": "^7.7.3",
    "@langfuse/otel": "5.4.1",
    "@opentelemetry/api": "1.9.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.112.0",
    "@vercel/otel": "2.1.2",
    "@yawaragi/sakenowa-mcp": "0.1.0",
    "ai": "^6.0.209",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "16.3.0",
    "next-intl": "^4.13.4",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.10.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testcontainers/postgresql": "~11.14.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26",
    "@types/pg": "~8.20.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "happy-dom": "^20.11.1",
    "pg": "~8.21.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.5",
    "typescript": "^6",
    "vitest": "^4.1.10"
  }
}
