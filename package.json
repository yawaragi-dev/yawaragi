{
  "name": "yawaragi",
  "version": "0.1.0",
  "private": true,
  "description": "Yawaragi — a sake companion. Label scan, chat recommender, taste profile.",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yawaragi-dev/yawaragi.git"
  },
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:e2e": "playwright test",
    "i18n:audit": "tsx scripts/audit-i18n-promotional.ts",
    "progress": "tsx scripts/progress-dashboard.ts",
    "anthropic-files:audit": "tsx scripts/audit-anthropic-files-api.ts",
    "migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "db:reset": "tsx --env-file=.env.local scripts/reset-db.ts",
    "ingest": "tsx --env-file=.env.local scripts/ingest-sakenowa.ts",
    "add-manual-brand": "tsx --env-file=.env.local scripts/add-manual-brand.ts",
    "sakenowa:freshness": "tsx --env-file=.env.local scripts/sakenowa-freshness-check.ts",
    "rate-limit:reset": "tsx --env-file=.env.local scripts/clear-rate-limit.ts",
    "db:resync": "npm run db:reset -- --yes && npm run migrate && npm run ingest",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run test:integration && npm run test:e2e && npm run i18n:audit && npm run anthropic-files:audit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.81",
    "@ai-sdk/mcp": "^1.0.45",
    "@ai-sdk/react": "^3.0.196",
    "@base-ui/react": "^1.4.1",
    "@clerk/nextjs": "^7.3.4",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "ai": "^6.0.194",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "16.2.7",
    "next-intl": "^4.13.0",
    "next-themes": "^0.4.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "shadcn": "^4.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testcontainers/postgresql": "~11.14.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22",
    "@types/pg": "~8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "happy-dom": "^20.9.0",
    "pg": "~8.21.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5",
    "vitest": "^4.1.6"
  }
}
