# Anthropic — https://console.anthropic.com/settings/keys
# REQUIRED. The vision provider (label scan; Phase 3 / S3 #108) reads
# this through the AI SDK's `anthropic` factory. Production / Preview /
# Development on Vercel must all carry a value (e.g. a `sk-ant-…` key);
# `env.parse` fails fast at boot if missing. Local dev: a real API key
# for hand-testing the scan; in CI, vitest does not call out (mocks at
# the seam level) but the parse still needs a non-empty string —
# `dev-only-dummy-anthropic-key` is fine for that gate.
ANTHROPIC_API_KEY=dev-only-dummy-anthropic-key

# Vision provider seam — picks which entry in the registry handles the
# scan extraction (#108). Defaults to `anthropic-haiku-4-5` if unset.
# A future fallback vendor (Phase 4-ish) lands as a new registry key +
# a flip of this var, not a code rewrite. Tests instantiate providers
# directly and never read this.
VISION_PROVIDER=anthropic-haiku-4-5

# Supabase — https://supabase.com/dashboard/project/<project>/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string for the Supabase project — Project → Settings →
# Database → Connection string (URI mode). Used by the server-side pg.Pool
# for ingestion + read-side lookups. Format:
#   postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Clerk — https://dashboard.clerk.com
# REQUIRED. The app fails at env.parse (src/env.ts) if these are missing.
# Get keys from a Clerk development instance ("API Keys" page in the
# dashboard). pk_test_ / sk_test_ values work for local dev + CI; production
# uses pk_live_ / sk_live_ values stashed in Vercel project envs.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Langfuse (optional) — https://cloud.langfuse.com/project/<project>/settings
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Cron endpoint protection — generate with: openssl rand -hex 32
# Default left non-empty (16+ chars) so `cp .env.example .env.local`
# satisfies the z.string().min(16) validation in src/env.ts without
# crashing the dev server. Rotate to a real secret before any deploy
# that actually exposes the route.
CRON_SECRET=dev-only-dummy-32-character-secret

# Next.js telemetry (anonymised build-time usage stats sent to Vercel).
# Disabled by default per ADR-0009 (data minimisation; no DPA with Vercel).
# Re-enable only with an explicit ADR update.
NEXT_TELEMETRY_DISABLED=1

# Phase 3 / S2 — anonymous-session cookie + vision-scan rate limit (#107)
#
# HMAC secret for the `yawaragi_session` cookie. Generate with:
#   openssl rand -hex 32
# Must be 32+ chars. Rotating invalidates every active session — visitors
# get fresh cookies and a reset budget. Required in production; local dev
# falls back to "no enforcement" with a console warning when unset.
SESSION_COOKIE_SECRET=dev-only-session-secret-32-characters-min
# Server-side rotating salt for the SHA-256 IP hash. The plaintext IP is
# NEVER persisted; only its salted hash reaches the KV. Rotate to bump
# every IP budget at once.
IP_HASH_SALT=dev-only-ip-hash-salt-16+chars
# Upstash Redis (EU region) — REST endpoint + token. Provision in the
# Upstash dashboard, pick an EU region (e.g. eu-central-1 Frankfurt),
# and paste the REST URL + REST token here. The rate-limit module talks
# to this over fetch (no SDK dep). DPA must be signed before Production
# deployment — see ADR-0009 RoPA.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# `@yawaragi/sakenowa-mcp` (Phase 4 / S1 #139) — the URL of the deployed
# MCP server. Optional in env.parse; the MCP-client factory throws at
# first use with a clear message when unset. Local dev workflow:
#   1. `pnpm link ../sakenowa-mcp` (per docs/development/local-mcp.md §1)
#   2. Wrap the stdio binary in an HTTP gateway and set MCP_SAKENOWA_URL
#      to the gateway URL — currently maintainer-specific tooling.
# Production / Preview on Vercel use the deployed MCP project URL.
MCP_SAKENOWA_URL=

# Dev/preview escape hatch for the anonymous rate limit. Absence is the
# safe default (rate limit enforced). Set to `1` locally when iterating
# on the rate-limited surfaces (suggest 3/24h, scan 5/24h) so you don't
# have to wait 24h between attempts. Safe to set on Vercel Preview too
# if you want a preview deploy to be unmetered. NEVER set on Production
# Vercel — a stray `RATE_LIMIT_BYPASS=1` there silently unmeters the
# paid-API cost protection.
RATE_LIMIT_BYPASS=

# Phase 5.5 — maintainer allowlist for the private-beta tasting journal
# (ADR-0020). Comma-separated Clerk user ids (`user_…`) allowed to reach the
# PERSISTENT journal; everyone else gets the interactive-but-ephemeral example.
# Server-only — never prefix with NEXT_PUBLIC (it must not ship to the client).
# Unset ⇒ empty allowlist ⇒ example-only everywhere (fail-closed). Set to your
# own Clerk user id locally once the journal UI (P5.5-C) lands.
MAINTAINER_USER_IDS=
