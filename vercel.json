{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "fra1"
  ],
  "ignoreCommand": "sh scripts/vercel-ignore-build.sh",
  "crons": [
    {
      "path": "/api/cron/ingest",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/backup-collection",
      "schedule": "30 3 * * *"
    }
  ]
}
